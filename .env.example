# ==========================================================
# Copy to .env and fill in. NEVER commit .env
# ==========================================================

# Какой образ бота запускать. Пишется деплоем автоматически; трогать руками
# нужно только для отката на прошлую версию.
BOT_IMAGE=

# --- Environment ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Telegram ---
# BotFather token. Use the DEV bot locally, the PROD bot on the server.
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot at all.
# LEAVE EMPTY TO OPEN THE BOT TO EVERYONE - they arrive as regular users.
# Fill it in to close the bot down again; the bot tells a rejected user
# their own ID, so you can add it here.
ALLOWED_TELEGRAM_IDS=

# Owners. Their admin rights are restored whenever they touch the bot, so
# wiping the database cannot lock you out of /grant and /users.
ADMIN_TELEGRAM_IDS=

# --- PostgreSQL ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gym_assistant
# Use "postgres" inside Docker, "localhost" when running the bot from your machine.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Anthropic ---
# Без ключа бот работает, но ассистент и оценка состава тела по фото выключены.
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5
# Модель для фото. Не менять посреди истории: другая модель читает тот же
# снимок с другим смещением, и тренд по оценкам сломается.
AI_MODEL_VISION=claude-sonnet-5
AI_MONTHLY_LIMIT_USD=10

# --- Часовой пояс ---
# По какому времени режутся дни и недели в статистике. В базе всё в UTC, эта
# настройка решает только, где кончается день при группировке. Тренировка в
# шесть утра понедельника во Вьетнаме — это 23:00 воскресенья по UTC, и по
# UTC она ушла бы в прошлую неделю.
# Список имён: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=UTC
