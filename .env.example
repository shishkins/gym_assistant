# ==========================================================
# Copy to .env and fill in. NEVER commit .env
# ==========================================================

# --- Environment ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Telegram ---
# BotFather token. Use the DEV bot locally, the PROD bot on the server.
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot.
# The bot tells an unknown user their own ID, so you can add it here.
ALLOWED_TELEGRAM_IDS=

# --- PostgreSQL ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gym_assistant
# Use "postgres" inside Docker, "localhost" when running the bot from your machine.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Anthropic (iteration 5+, may stay empty until then) ---
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5
AI_MONTHLY_LIMIT_USD=10

# --- Speech to text (iteration 6+) ---
STT_URL=http://stt:8000
STT_MODEL=small
